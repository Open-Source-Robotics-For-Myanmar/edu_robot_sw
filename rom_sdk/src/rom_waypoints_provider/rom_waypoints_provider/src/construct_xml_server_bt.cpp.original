int main(int argc, char **argv)
{
  rclcpp::init(argc, argv);
  
  std::shared_ptr<rclcpp::Node> node = rclcpp::Node::make_shared("construct_bt_xml_server", rom_robot_namespace);
  bt_stop_node = rclcpp::Node::make_shared("bt_stop_client_node", rom_robot_namespace);
  
  auto qos = rclcpp::QoS(1); 
  qos.transient_local(); 

  //အခြား qt app များမှ waypoints များကို ရယူရန် အတွက် publisher တည်ဆောက်ခြင်းဖြစ်သည်။
  publisher_ = node->create_publisher<rom_interfaces::msg::ConstructYaml>("waypoints_list", qos);

  //qt မှ wp များကို behavior tree တည်ဆောက်ပေးရန် အတွက် service တည်ဆောက်ခြင်းဖြစ်သည်။
  rclcpp::Service<rom_interfaces::srv::ConstructYaml>::SharedPtr service = node->create_service<rom_interfaces::srv::ConstructYaml>("construct_yaml_and_bt", &construct_xml_file);

  bt_client = bt_stop_node->create_client<std_srvs::srv::SetBool>("bt_stop");

  #ifdef ROM_DEBUG
    RCLCPP_INFO(rclcpp::get_logger("construct_xml"), "Ready to construct behavior tree and yaml for waypoints, service and patrol mode");
  #endif

  rclcpp::spin(node);
  rclcpp::shutdown();
}
/*
```
- bt tree ရဲ့ ComputePathToPose ကိုပေးတဲ့ rate_controller ကတော့ default အားဖြင့် 1.0 ပါ။ 0.5 ထားရင်တော့ compute power လျော့ချနိုင်မှာဖြစ်ပြီး recover လုပ်တာတော့ နှေးသွားနိုင်ပါတယ်။ မြန်ချင်ရင် 2.0 ထားပေါ့။

- ComputePathToPose ကလည်း အောက် FollowPath နဲ့ အတူတူပါပဲ။

- FollowPath ရဲ့ server_timeout က default တန်ဖိုး 10.0 ပါ။ စမ်းချင်ရင် 15.0 ထားပါ။

- ClearEntireCostmap ရဲ့ server_timeout ကတော့ default အားဖြင့် 10.0 ပါတဲ့။ global, local တွေအတွက်ပေါ့။

- /spin server ရဲ့ time_allowance ဆိုတာ default အားဖြင့် -1.0 ဖြစ်ပြီး ဆိုလိုတာက no timeout လို့ဆိုလိုတယ်။ ထားချင်ရင်တော့ 10.0 နဲ့စမ်းပါ။ 
server_timeout ကတော့ 10.0 ထားပါ။ 
spin_distance က 1.57 ကတော့ 90 degree ကိုဆိုလိုတယ်။

/wait server ရဲ့ server_timeout ကတော့ default အားဖြင့် 10.0 ပါ။ စမ်းချင်ရင်တော့ 15.0 ထားစမ်းပါ။ သူ့ရဲ့ wait_duration ကတော့ 5 seconds လောက်ထားရင်အဆင်ပြေပါတယ်။

/backup server ရဲ့ time_allowance ကတော့ infinite ဖြစ်တဲ့ -1.0 ဖြစ်ပြီး server_timeout ကတော့ 10.0 ဖြစ်ပါတယ်။ backup_distance က 0.30 ဆိုတာကတော့ 30 centimeter နောက်ဆုတ်ပြီး backup လုပ်မှာဖြစ်ပါတယ်။
backup_speed 0.05 ဆိုတာကတော့ 5 centermeter per second လို့ဆိုလိုတာ။

```
*/


