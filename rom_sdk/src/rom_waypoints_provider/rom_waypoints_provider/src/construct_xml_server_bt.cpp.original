        try {
          double v = std::stod(val);
          if (key == "x") cur_pose_stamped.pose.position.x = v;
          else if (key == "y") cur_pose_stamped.pose.position.y = v;
          else if (key == "z") cur_pose_stamped.pose.position.z = v;
